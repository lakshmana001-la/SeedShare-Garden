              "body": "{\n  \"success\": true,\n  \"message\": \"Plot created successfully.\",\n  \"data\": {\n    \"id\": 51,\n    \"plot_name\": \"Plot Z1\",\n    \"soil_type\": \"Loam\",\n    \"size_sqm\": 25,\n    \"deleted\": 0\n  }\n}"
