              "raw": "{\n  \"plot_name\": \"Plot Z1\",\n  \"soil_type\": \"Loam\",\n  \"size_sqm\": 25,\n  \"location\": \"Test Section\",\n  \"sunlight\": \"Full Sun\",\n  \"water_source\": \"Tap\",\n  \"monthly_rent\": 18,\n  \"max_gardeners\": 2,\n  \"notes\": \"New test plot\"\n}",
