{
  "info": {
    "_postman_id": "seedshare-garden-collection-v1",
    "name": "SeedShare Garden API",
    "description": "Complete Postman collection for the SeedShare Garden backend API.\n\nIncludes all endpoints for Plots, Gardeners, Leases, the Join endpoint, and Soft Delete / Restore tests.\n\n**Base URL:** http://localhost:3000\n\n**How to use:**\n1. Start the server: `node server.js`\n2. Import this file into Postman\n3. Run the requests in order",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Plots",
      "description": "CRUD operations for garden plots, including soft-delete and restore.",
      "item": [
        {
          "name": "GET All Plots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/plots",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plots"]
            },
            "description": "Returns all active (non-deleted) plots. Expected status: 200."
          },
          "response": [
            {
              "name": "200 OK — All Plots",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"count\": 50,\n  \"data\": [\n    {\n      \"id\": 1,\n      \"plot_name\": \"Plot A1\",\n      \"soil_type\": \"Clay\",\n      \"size_sqm\": 20,\n      \"location\": \"North Section\",\n      \"sunlight\": \"Full Sun\",\n      \"water_source\": \"Tap\",\n      \"monthly_rent\": 15,\n      \"max_gardeners\": 1,\n      \"notes\": \"Near entrance gate\",\n      \"deleted\": 0,\n      \"created_at\": \"2024-01-01 10:00:00\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "GET One Plot",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/plots/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plots", "1"]
            },
            "description": "Returns a single plot by ID. Returns 404 if deleted or not found."
