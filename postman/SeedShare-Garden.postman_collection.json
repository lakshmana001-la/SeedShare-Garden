          "name": "Test 2 — GET /plots/9 → 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/plots/9",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plots", "9"]
            },
            "description": "STEP 2: Try to get deleted plot 9. Expected response: 404 Not Found."
          }
        },
        {
          "name": "Test 3 — POST /plots/9/restore → 200",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
