        {
          "name": "DELETE Plot (Soft Delete) — Test 1",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/plots/9",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plots", "9"]
            },
            "description": "⭐ SOFT DELETE TEST 1: DELETE /plots/9 → Expected: 200 OK\nThis does NOT permanently remove the plot. It sets deleted = 1."
          },
          "response": [
            {
              "name": "200 OK — Soft Deleted",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Plot \\\"Plot B4\\\" (ID: 9) has been soft-deleted. It can be restored.\"\n}"
            }
          ]
        },
        {
          "name": "GET Deleted Plot — Test 2",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/plots/9",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plots", "9"]
            },
            "description": "⭐ SOFT DELETE TEST 2: GET /plots/9 after deletion → Expected: 404 Not Found\nDeleted plots should not appear in GET responses."
          },
          "response": [
            {
              "name": "404 Not Found — Plot is deleted",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"success\": false,\n  \"message\": \"Plot with ID 9 not found or has been deleted.\"\n}"
            }
          ]
        },
        {
          "name": "POST Restore Plot — Test 3",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/plots/9/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plots", "9", "restore"]
            },
            "description": "⭐ SOFT DELETE TEST 3: POST /plots/9/restore → Expected: 200 OK\nAfter restoring, GET /plots/9 should return 200."
          },
          "response": [
            {
              "name": "200 OK — Restored",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Plot \\\"Plot B4\\\" (ID: 9) has been successfully restored.\",\n  \"data\": {\n    \"id\": 9,\n    \"plot_name\": \"Plot B4\",\n    \"soil_type\": \"Sandy\",\n    \"deleted\": 0\n  }\n}"
            }
          ]
        },
        {
          "name": "GET Restored Plot (After Test 3)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/plots/9",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plots", "9"]
            },
            "description": "After restoring plot 9, this GET should return 200. Verifies the restore worked."
          },
          "response": [
            {
              "name": "200 OK — Plot Restored",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": 9,\n    \"plot_name\": \"Plot B4\",\n    \"soil_type\": \"Sandy\",\n    \"deleted\": 0\n  }\n}"
            }
          ]
        },
