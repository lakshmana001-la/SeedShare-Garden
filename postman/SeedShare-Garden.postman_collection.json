              "name": "200 OK — Single Plot",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": 1,\n    \"plot_name\": \"Plot A1\",\n    \"soil_type\": \"Clay\",\n    \"size_sqm\": 20\n  }\n}"
            },
