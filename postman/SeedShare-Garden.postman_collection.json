    {
      "name": "⭐ Soft Delete Tests (Run In Order)",
      "description": "Run these three tests in order to verify soft delete and restore functionality.",
      "item": [
        {
          "name": "Test 1 — DELETE /plots/9 → 200",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
